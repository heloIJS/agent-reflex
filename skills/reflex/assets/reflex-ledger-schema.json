{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReflexMemoryRule",
  "description": "Version 2 local learning rule. Verified means a recorded, scoped mutation test passed, not universal correctness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "topic", "status", "category", "root_cause", "trigger", "action", "verify", "target", "tags", "created", "updated", "failure_count", "correction_count", "verification", "deprecation_reason"],
  "properties": {
    "id": {"type": "string", "pattern": "^rfx-[a-f0-9]{16}$"},
    "topic": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64},
    "status": {"type": "string", "enum": ["provisional", "verified", "deprecated"]},
    "category": {
      "type": "string",
      "enum": ["EPISTEMIC_DRIFT", "TAUTOLOGICAL_CHECK", "PREMATURE_EXECUTION", "TOOL_OR_API_HALLUCINATION", "CONTEXT_DECAY", "OVER_EDITING", "DOMAIN_PIPELINE_BUG", "OTHER"]
    },
    "root_cause": {"type": "string", "minLength": 1, "maxLength": 300},
    "trigger": {"type": "string", "minLength": 1, "maxLength": 1024},
    "action": {"type": "string", "minLength": 1, "maxLength": 1024},
    "verify": {"type": "string", "minLength": 1, "maxLength": 1024},
    "target": {"type": "string", "minLength": 1, "maxLength": 200},
    "tags": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "created": {"type": "string", "minLength": 1, "maxLength": 64},
    "updated": {"type": "string", "minLength": 1, "maxLength": 64},
    "failure_count": {"type": "integer", "minimum": 0},
    "correction_count": {"type": "integer", "minimum": 0},
    "verification": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["passed", "mutation", "created", "command_hash", "fixture_hash"],
        "properties": {
          "passed": {"type": "boolean"},
          "mutation": {"type": "string", "enum": ["empty-file", "truncate-json", "invalid-json", "json-null-key"]},
          "created": {"type": "string", "minLength": 1, "maxLength": 64},
          "command_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "fixture_hash": {"type": "string", "pattern": "^([a-f0-9]{64})?$"}
        }
      }
    },
    "deprecation_reason": {"type": "string", "maxLength": 300}
  }
}
