{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReflexLedgerEntry",
  "description": "One JSON object per line for a distilled, validated Reflex rule.",
  "type": "object",
  "required": [
    "id",
    "status",
    "category",
    "trigger",
    "action",
    "verify",
    "target"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rfx-[a-z0-9][a-z0-9-]{2,63}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "provisional",
        "validated",
        "active",
        "superseded"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "EPISTEMIC_DRIFT",
        "TAUTOLOGICAL_CHECK",
        "PREMATURE_EXECUTION",
        "TOOL_OR_API_HALLUCINATION",
        "CONTEXT_DECAY",
        "OVER_EDITING",
        "DOMAIN_PIPELINE_BUG",
        "OTHER"
      ]
    },
    "root_cause": {
      "type": "string",
      "maxLength": 300
    },
    "trigger": {
      "type": "string",
      "minLength": 12
    },
    "action": {
      "type": "string",
      "minLength": 12
    },
    "verify": {
      "type": "string",
      "minLength": 12
    },
    "target": {
      "type": "string",
      "description": "Skill name, file path, or workflow target."
    },
    "target_section": {
      "type": "string"
    },
    "replaces": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Safe, non-sensitive validation notes."
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lint": {
          "type": "boolean"
        },
        "saboteur": {
          "type": "boolean"
        },
        "audit": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "examples": [
    {
      "id": "rfx-ffmpeg-bgm-ducking",
      "status": "validated",
      "category": "DOMAIN_PIPELINE_BUG",
      "root_cause": "Background music masked speech because no loudness guardrail was applied.",
      "trigger": "mixing narration TTS with background music in FFmpeg",
      "action": "duck background music about 18 dB below the voice because loud music masks speech",
      "verify": "run ffmpeg -i out.mp4 -af ebur128 -f null - and require integrated loudness between -15 and -13 LUFS",
      "target": "media-video",
      "target_section": "Audio Mixing",
      "tags": [
        "ffmpeg",
        "audio",
        "tts"
      ],
      "validation": {
        "lint": true,
        "saboteur": true,
        "audit": true
      },
      "created": "2026-11-11",
      "last_verified": "2026-11-11"
    }
  ]
}
